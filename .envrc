use flake

prompt_poetry_env_creation() {
  local reply tty_fd

  if [[ -n ${DIRENV_POETRY_ENV_PROMPTED-} ]]; then
    return 0
  fi

  if ! { exec {tty_fd}<> /dev/tty; } 2>/dev/null; then
    log_status 'No Poetry environment found. Run `poetry install` and then `direnv reload`.'
    return 0
  fi

  export DIRENV_POETRY_ENV_PROMPTED=1

  printf 'direnv: No Poetry environment found. Create one with `poetry install` now? [y/N] ' >&$tty_fd
  if ! read -r reply <&$tty_fd; then
    printf '\n' >&$tty_fd
    exec {tty_fd}>&-
    log_status 'Run `poetry install` and then `direnv reload` to enable the environment.'
    return 0
  fi

  case "$reply" in
    [Yy]|[Yy][Ee][Ss])
      if poetry install <&$tty_fd >&$tty_fd 2>&1; then
        log_status 'Poetry environment created.'
      else
        log_error 'Poetry environment creation failed. Run `poetry install` manually.'
      fi
      ;;
    *)
      log_status 'Skipping Poetry environment creation. Run `poetry install` when ready.'
      ;;
  esac

  exec {tty_fd}>&-
}

layout_poetry() {
  local project_dir=${1:-.}

  watch_file "$project_dir/pyproject.toml" "$project_dir/poetry.lock"

  if [[ ! -f $project_dir/pyproject.toml ]]; then
    log_status "No pyproject.toml found in $project_dir. Run \`poetry init\` or \`poetry new\` first."
    return 0
  fi

  if ! has poetry; then
    log_status 'Poetry is not available in this shell yet. Fix the flake environment or install Poetry first.'
    return 0
  fi

  local venv
  venv=$(cd "$project_dir" && poetry env info --path 2>/dev/null || true)
  if [[ -z $venv || ! -d $venv/bin ]]; then
    (cd "$project_dir" && prompt_poetry_env_creation)
    venv=$(cd "$project_dir" && poetry env info --path 2>/dev/null || true)
  fi

  if [[ -z $venv || ! -d $venv/bin ]]; then
    return 0
  fi

  unset DIRENV_POETRY_ENV_PROMPTED
  export VIRTUAL_ENV=$venv
  export POETRY_ACTIVE=1
  PATH_add "$venv/bin"
}

layout_poetry backend
